#include "chary.dtsi"

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix-transform = &default_transform;
        zmk,physical-layout = &charybdis;
        zmk,studio-rpc-usb-uart = &app_studio_rpc_usb_uart;
    };

    app_studio_rpc_usb_uart: app_studio_rpc_usb_uart {
        compatible = "zmk,studio-rpc-usb-uart";
    };
};

&kscan0 {
    compatible = "zmk,kscan-mock";
    columns = <12>;
    rows = <5>;
    events = <0>;
};
