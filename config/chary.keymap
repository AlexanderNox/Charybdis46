#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define DEFAULT 0
#define NUMBER  1
#define SYMBOL  2
#define HOTKEY  3

#define AS(keycode) &as LS(keycode) keycode

/ {
    macros {
        macro_email_q: macro_email_q {
            // 714448168@qq.com

            label = "MACRO_EMAIL_QQ";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp N7 &kp N1 &kp N4 &kp N4 &kp N4 &kp N8 &kp N1 &kp N6 &kp N8 &kp AT &kp Q &kp Q &kp DOT &kp C &kp O &kp M>;
        };

        GUANJIANCI: GUANJIANCI {
            compatible = "zmk,behavior-macro";
            label = "new_macro";
            #binding-cells = <0>;
            bindings = <&kp LSHIFT &kp LBKT &kp RBKT &kp LEFT &kp LSHIFT>;
        };

        TapDot: TapDot {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp DOT>;
            label = "TAPDOT";
        };

        Macro_dot: macro_dot {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <5>;
            tap-ms = <5>;
            bindings =
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp KP_N4 &kp KP_N6>,
                <&macro_release>,
                <&kp LALT>;
        };
    };

    combos {
        compatible = "zmk,combos";

        Backspace {
            bindings = <&kp BACKSPACE>;
            key-positions = <31 32>;
            layers = <0>;
        };

        Delete {
            bindings = <&kp DELETE>;
            key-positions = <19 20>;
            layers = <0>;
        };

        Scroll {
            bindings = <&mo 1>;
            key-positions = <27 28>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            label = "DEFAULT";
            bindings = <
&trans  &trans   &trans          &trans            &trans              &trans  &trans  &trans              &trans            &trans          &trans    &trans
&trans  &trans   &kp W           &kp E             &kp R               &kp T   &kp Y   &kp U               &kp I             &kp O           &trans    &trans
&trans  &kp A    &mt LEFT_ALT S  &mt LEFT_SHIFT D  &mt LEFT_CONTROL F  &kp G   &kp H   &mt LEFT_CONTROL J  &mt LEFT_SHIFT K  &mt LEFT_ALT L  &kp SEMI  &trans
&trans  &kp Z    &kp X           &kp C             &kp V               &kp B   &kp N   &kp M               &kp COMMA         &kp DOT         &kp FSLH  &trans
        &kp TAB  &mo 3           &kp LEFT_WIN      &trans              &trans          &trans              &kp SPACE         &mo 2
            >;
        };

        Scroll {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
        &trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans
            >;
        };

        number_layer {
            label = "NUMBER";
            bindings = <
&trans  &trans        &trans          &trans                       &trans                          &trans     &trans         &trans                 &trans                   &trans              &trans  &trans
&trans  &trans        &kp NUMBER_2    &kp NUMBER_3                 &kp NUMBER_4                    &kp N5     &kp NUMBER_6   &kp N7                 &kp N8                   &kp N9              &trans  &trans
&trans  &kp NUMBER_1  &mt LEFT_ALT Q  &mt LEFT_SHIFT LEFT_BRACKET  &mt LEFT_CONTROL RIGHT_BRACKET  &kp EQUAL  &kp BACKSPACE  &mt LEFT_CONTROL LEFT  &mt LEFT_SHIFT UP_ARROW  &mt LEFT_ALT RIGHT  &kp P   &trans
&trans  &kp N0        &kp ESC         &kp GRAVE                    &kp APOSTROPHE                  &kp MINUS  &kp DELETE     &kp ENTER              &kp DOWN_ARROW           &kp CAPS            &to 4   &trans
        &trans        &trans          &trans                       &trans                          &trans                    &trans                 &trans                   &trans
            >;
        };

        Add-Layer {
            bindings = <
&trans  &trans  &trans  &trans  &trans     &trans     &trans  &trans  &trans      &trans   &trans   &trans
&trans  &kp F1  &kp F3  &kp F4  &kp F5     &kp F6     &kp F7  &kp F8  &kp F9      &kp F10  &trans   &trans
&trans  &trans  &trans  &mo 1   &mkp LCLK  &mkp RCLK  &trans  &trans  &Macro_dot  &trans   &kp F11  &trans
&trans  &trans  &trans  &trans  &trans     &trans     &trans  &trans  &trans      &trans   &kp F12  &trans
        &trans  &trans  &trans  &trans     &trans             &trans  &trans      &trans
            >;
        };

        symbol_layer {
            label = "SYMBOL";
            bindings = <
&trans  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &bt BT_CLR    &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &bt BT_CLR
&trans  &bt BT_SEL 0  &none         &none         &none         &out OUT_USB  &out OUT_USB  &none         &none         &none         &none         &trans
&trans  &sys_reset    &none         &none         &none         &out OUT_BLE  &out OUT_BLE  &none         &none         &none         &sys_reset    &trans
&trans  &bootloader   &none         &none         &none         &none         &bt BT_CLR    &none         &none         &none         &bootloader   &trans
        &none         &to 0         &none         &none         &none                       &none         &none         &to 0
            >;
        };
    };
};
