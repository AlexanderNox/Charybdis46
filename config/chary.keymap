#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

#define DEFAULT 0
#define NUMBER  1
#define SYMBOL  2
#define HOTKEY  3

#define AS(keycode) &as LS(keycode) keycode

/ {
    macros {
        macro_email_q: macro_email_q {
            // 714448168@qq.com

            label = "MACRO_EMAIL_QQ";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp N7 &kp N1 &kp N4 &kp N4 &kp N4 &kp N8 &kp N1 &kp N6 &kp N8 &kp AT &kp Q &kp Q &kp DOT &kp C &kp O &kp M>;
        };

        GUANJIANCI: GUANJIANCI {
            compatible = "zmk,behavior-macro";
            label = "new_macro";
            #binding-cells = <0>;
            bindings = <&kp LSHIFT &kp LBKT &kp RBKT &kp LEFT &kp LSHIFT>;
        };

        TapDot: TapDot {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp DOT>;
            label = "TAPDOT";
        };

        Macro_dot: macro_dot {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <5>;
            tap-ms = <5>;
            bindings =
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp KP_N4 &kp KP_N6>,
                <&macro_release>,
                <&kp LALT>;
        };

        Macro_comma: macro_comma {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <5>;
            tap-ms = <5>;
            bindings = <&kp COMMA>;
        };

        Macro_question: macro_question {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <5>;
            tap-ms = <5>;
            bindings = <&kp QUESTION>;
        };

        altF4_macro: altF4_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none>;
            label = "ALTF4_MACRO";
        };
    };

    combos {
        compatible = "zmk,combos";

        Delete {
            bindings = <&kp DELETE>;
            key-positions = <39 40>;
            layers = <0>;
        };

        Enter {
            bindings = <&kp ENTER>;
            key-positions = <27 28>;
        };

        ToWork {
            bindings = <&to 0>;
            key-positions = <28 29>;
        };

        ToGame {
            bindings = <&to 4>;
            key-positions = <40 41>;
        };

        altF4 {
            bindings = <&kp LA(F4)>;
            key-positions = <27 26>;
            layers = <0 1 2 3>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Main-Layer {
            label = "DEFAULT";
            bindings = <
&trans            &trans        &trans  &trans        &trans  &trans  &trans  &trans  &trans     &trans   &trans    &trans
&kp TAB           &kp Q         &kp W   &kp E         &kp R   &kp T   &kp Y   &kp U   &kp I      &kp O    &kp P     &kp LEFT_BRACKET
&kp LEFT_SHIFT    &kp A         &kp S   &kp D         &kp F   &kp G   &kp H   &kp J   &kp K      &kp L    &kp SEMI  &kp RIGHT_BRACKET
&kp LEFT_CONTROL  &kp Z         &kp X   &kp C         &kp V   &kp B   &kp N   &kp M   &kp COMMA  &kp DOT  &kp FSLH  &kp SQT
                  &kp LEFT_WIN  &mo 2   &kp LEFT_ALT  &trans  &trans          &trans  &kp SPACE  &mo 1
            >;
        };

        RightSupport-Layer {
            label = "NUMBER";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans          &trans          &trans     &trans         &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans          &trans          &trans     &trans         &to 3
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp LEFT_ARROW  &kp UP          &kp RIGHT  &kp PAGE_UP    &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp HOME        &kp DOWN_ARROW  &kp END    &kp PAGE_DOWN  &trans
        &trans  &trans  &trans  &trans  &trans          &trans          &trans          &trans
            >;
        };

        LeftSupport-Layer {
            bindings = <
&trans  &trans        &trans  &trans   &trans   &trans   &trans        &trans        &trans        &trans        &trans         &trans
&trans  &kp ESCAPE    &kp F1  &kp F2   &kp F3   &kp F4   &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp BACKSPACE  &kp BACKSLASH
&trans  &kp GRAVE     &kp F5  &kp F6   &kp F7   &kp F8   &kp N5        &kp NUMBER_6  &kp N7        &kp N8        &kp ENTER      &Macro_dot
&trans  &kp CAPSLOCK  &kp F9  &kp F10  &kp F11  &kp F12  &kp N9        &kp N0        &kp MINUS     &kp EQUAL     &kp DELETE     &trans
        &trans        &trans  &trans   &trans   &trans                 &trans        &trans        &trans
            >;
        };

        Functional-Layer {
            label = "SYMBOL";
            bindings = <
&trans  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &bt BT_CLR    &trans        &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &trans
&trans  &trans        &none         &none         &none         &out OUT_USB  &out OUT_USB  &none         &none         &none         &none         &trans
&trans  &trans        &none         &none         &bt BT_SEL 0  &out OUT_BLE  &out OUT_BLE  &bt BT_SEL 0  &none         &none         &sys_reset    &trans
&trans  &trans        &none         &sys_reset    &bootloader   &bt BT_CLR    &bt BT_CLR    &bootloader   &sys_reset    &none         &bootloader   &trans
        &none         &to 0         &none         &none         &none                       &none         &none         &to 0
            >;
        };

        Game-Main-Layer {
            bindings = <
&trans  &trans            &trans  &trans     &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&kp T   &kp ESCAPE        &kp Q   &kp X      &kp E   &kp R   &trans  &trans  &trans  &trans  &trans  &trans
&kp G   &kp LEFT_SHIFT    &kp A   &kp W      &kp D   &kp F   &trans  &trans  &trans  &trans  &trans  &trans
&kp B   &kp LEFT_CONTROL  &kp Z   &kp S      &kp C   &kp V   &trans  &trans  &trans  &trans  &trans  &trans
        &kp LEFT_ALT      &mo 5   &kp SPACE  &trans  &trans          &trans  &trans  &trans
            >;
        };

        Game-Support-Layer {
            bindings = <
&trans  &trans   &trans  &trans  &trans        &trans        &trans  &trans   &trans   &trans   &trans  &trans
&trans  &kp TAB  &trans  &trans  &kp NUMBER_1  &kp NUMBER_4  &kp F1  &kp F2   &kp F3   &kp F4   &trans  &trans
&trans  &trans   &trans  &trans  &kp NUMBER_2  &kp N5        &kp F5  &kp F6   &kp F7   &kp F8   &trans  &trans
&trans  &trans   &trans  &trans  &kp NUMBER_3  &kp NUMBER_6  &kp F9  &kp F10  &kp F11  &kp F12  &trans  &trans
        &trans   &trans  &trans  &trans        &trans                &trans   &trans   &trans
            >;
        };
    };
};
