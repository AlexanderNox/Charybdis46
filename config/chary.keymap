#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define DEFAULT 0
#define NUMBER  1
#define SYMBOL  2
#define HOTKEY  3

#define AS(keycode) &as LS(keycode) keycode

/ {
    macros {
        macro_email_q: macro_email_q {
            // 714448168@qq.com

            label = "MACRO_EMAIL_QQ";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp N7 &kp N1 &kp N4 &kp N4 &kp N4 &kp N8 &kp N1 &kp N6 &kp N8 &kp AT &kp Q &kp Q &kp DOT &kp C &kp O &kp M>;
        };

        GUANJIANCI: GUANJIANCI {
            compatible = "zmk,behavior-macro";
            label = "new_macro";
            #binding-cells = <0>;
            bindings = <&kp LSHIFT &kp LBKT &kp RBKT &kp LEFT &kp LSHIFT>;
        };

        TapDot: TapDot {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp DOT>;
            label = "TAPDOT";
        };

        Macro_dot: macro_dot {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <5>;
            tap-ms = <5>;
            bindings =
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp KP_N4 &kp KP_N6>,
                <&macro_release>,
                <&kp LALT>;
        };
    };

    combos {
        compatible = "zmk,combos";

        Backspace {
            bindings = <&kp BACKSPACE>;
            key-positions = <31 32>;
            layers = <0>;
        };

        Delete {
            bindings = <&kp DELETE>;
            key-positions = <19 20>;
            layers = <0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            label = "DEFAULT";
            bindings = <
&trans            &trans  &trans          &trans        &trans  &trans  &trans  &trans  &trans     &trans     &trans    &kp RBKT
&kp TAB           &kp Q   &kp W           &kp E         &kp R   &kp T   &kp Y   &kp U   &kp I      &kp O      &kp P     &kp LBKT
&kp CAPSLOCK      &kp A   &kp S           &kp D         &kp F   &kp G   &kp H   &kp J   &kp K      &kp L      &kp SEMI  &kp SQT
&kp LEFT_CONTROL  &kp Z   &kp X           &kp C         &kp V   &kp B   &kp N   &kp M   &kp COMMA  &kp DOT    &kp FSLH  &kp LEFT_ALT
                  &mo 3   &kp LEFT_SHIFT  &kp LEFT_WIN  &trans  &trans          &trans  &mo 2      &kp SPACE
            >;
        };

        Scroll {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
        &trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans
            >;
        };

        number_layer {
            label = "NUMBER";
            bindings = <
&trans   &trans        &trans        &trans        &trans        &trans     &trans         &trans     &trans          &trans     &trans  &trans
&kp ESC  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp N5     &kp NUMBER_6   &kp N7     &kp N8          &kp N9     &kp N0  &trans
&trans   &trans        &trans        &trans        &kp GRAVE     &kp EQUAL  &kp BACKSPACE  &kp LEFT   &kp UP_ARROW    &kp RIGHT  &to 4   &trans
&trans   &trans        &trans        &trans        &trans        &kp MINUS  &kp DELETE     &kp ENTER  &kp DOWN_ARROW  &trans     &trans  &trans
         &trans        &trans        &trans        &trans        &trans                    &trans     &trans          &trans
            >;
        };

        Add-Layer {
            bindings = <
&trans  &trans  &trans  &trans  &trans     &trans     &trans  &trans              &trans      &trans   &trans   &trans
&kp F1  &kp F2  &kp F3  &kp F4  &kp F5     &kp F6     &kp F7  &kp F8              &kp F9      &kp F10  &kp F11  &kp F12
&trans  &trans  &trans  &mo 1   &mkp LCLK  &mkp RCLK  &trans  &kp LA(LEFT_SHIFT)  &Macro_dot  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans     &trans     &trans  &trans              &trans      &trans   &trans   &trans
        &trans  &trans  &trans  &trans     &trans             &trans              &trans      &trans
            >;
        };

        symbol_layer {
            label = "SYMBOL";
            bindings = <
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &bt BT_CLR    &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &bt BT_CLR
&sys_reset    &none         &none         &none         &none         &out OUT_USB  &out OUT_USB  &none         &none         &none         &none         &sys_reset
&bootloader   &none         &none         &none         &none         &out OUT_BLE  &out OUT_BLE  &none         &none         &none         &none         &bootloader
&none         &none         &none         &none         &none         &none         &none         &none         &none         &none         &none         &none
              &to 0         &none         &none         &none         &none                       &none         &none         &to 0
            >;
        };
    };
};
